#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?missing commit message file}"
msg="$(cat "$msg_file")"

if [[ "$msg" =~ ^Merge[[:space:]] ]] || [[ "$msg" =~ ^Revert[[:space:]] ]]; then
  exit 0
fi

if ! grep -Eq '\[#([0-9]+)\]' "$msg_file"; then
  echo "commit-msg rejected: missing [#<issue>] prefix" >&2
  exit 1
fi
